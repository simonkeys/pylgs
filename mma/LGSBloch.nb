Cell[BoxData[
 RowBox[{
  RowBox[{"ExportLGSSystem", "[", 
   RowBox[{
   "dir_", ",", " ", "system_", ",", " ", "pumpTransitions_", ",", " ", 
    RowBox[{"opts", " ", ":", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "lgs", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"lgs", " ", "=", " ", 
      RowBox[{"LGSGenerateSystem", "[", 
       RowBox[{"system", ",", " ", "pumpTransitions", ",", " ", "opts"}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{"lgs", " ", "=", " ", 
      RowBox[{"lgs", " ", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"VGCenter", "[", "1", "]"}], " ", "->", " ", "1"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"VGInverseWidth", "[", "1", "]"}], "->", "1"}], ",", " ", 
         RowBox[{
          RowBox[{"VGDensity", "[", "1", "]"}], " ", "->", " ", "1"}]}], 
        "}"}]}]}], ";", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"lgs", " ", "=", " ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Most", "@", "lgs"}], " ", "/.", " ", 
           RowBox[{
            RowBox[{"VGWidth", "[", "1", "]"}], " ", "->", " ", 
            RowBox[{"1", "/", 
             RowBox[{"VGInverseWidth", "[", "1", "]"}]}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"Last", "@", "lgs"}], " ", "/.", " ", 
           RowBox[{
            RowBox[{"VGWidth", "[", "1", "]"}], " ", "->", " ", 
            RowBox[{"VGInverseWidth", "[", "1", "]"}]}]}]}], "]"}]}], ";"}], 
      "*)"}], "\n", "\t", 
     RowBox[{"Join", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ExportDecomposedMatrix", "[", 
          RowBox[{"dir", ",", " ", "#", ",", " ", 
           RowBox[{"standardizeNotation", "[", 
            RowBox[{"lgs", ",", " ", 
             RowBox[{"lgs", "@", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], "]"}], "&"}], " ",
         "/@", " ", 
        RowBox[{"{", "\n", "\t\t\t", 
         RowBox[{
          RowBox[{"{", "\"\<A_ind\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<A_dop\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<A_rec\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<A_vcc\>\"", "}"}], ",", " ", 
          RowBox[{"{", "\"\<b\>\"", "}"}], ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Flux\>\"", ",", 
            " ", "\"\<{\\\"long_name\\\": \\\"Flux\\\", \\\"units\\\": \
\\\"photon/atom/s/sr\\\"}\>\""}], "}"}]}], "\n", "\t\t", "}"}]}], ",", "\n", 
       "\t\t", 
       RowBox[{"{", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", " ", "\"\<LevelDiagramToy.svg\>\""}], "}"}], 
