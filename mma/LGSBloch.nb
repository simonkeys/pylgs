Cell[BoxData[
 RowBox[{
  RowBox[{"LGSSystemInfo", "[", "lgs_", "]"}], " ", ":=", " ", 
  RowBox[{"StringRiffle", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", "\n", "\t\t", 
     RowBox[{"\"\<#### Atomic levels\>\"", ",", "\n", "\t\t", 
      RowBox[{"texList", "@", 
       RowBox[{"lgs", "[", "\"\<StateLabels\>\"", "]"}]}], ",", "\n", 
      "\t\t", "\"\<#### Pump transitions\>\"", ",", "\n", "\t\t", 
      RowBox[{"texNumberedList", "@", 
       RowBox[{"lgs", "[", "\"\<PumpTransitions\>\"", "]"}]}], ",", "\n", 
      "\t\t", "\"\<#### Transition wavelengths\>\"", ",", "\n", "\t\t", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\"\<- $\>\"", "<>", 
           RowBox[{"ToString", "@", 
            RowBox[{"TeXForm", "@", "#1"}]}], "<>", "\"\<$: \>\"", " ", "<>", 
           " ", 
           RowBox[{"ToString", "@", "#2"}], " ", "<>", " ", "\"\< nm\>\""}], 
          "&"}], " ", "@@@", 
         RowBox[{"lgs", "[", "\"\<TransitionWavelengths\>\"", "]"}]}], ",", 
        " ", "\"\<\\n\>\""}], "]"}], ",", "\n", 
      "\t\t", "\"\<#### Substructure\>\"", ",", "\n", "\t\t", 
      RowBox[{"\"\<- Hyperfine structure \>\"", " ", "<>", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hasHyperfineStructure", "@", 
          RowBox[{"lgs", "[", "\"\<AtomicSystem\>\"", "]"}]}], ",", 
         " ", "\"\<included\>\"", ",", " ", "\"\<neglected\>\""}], "]"}]}], ",",
       "\n", "\t\t", 
      RowBox[{"\"\<- Zeeman structure \>\"", " ", "<>", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hasZeemanStructure", "@", 
          RowBox[{"lgs", "[", "\"\<AtomicSystem\>\"", "]"}]}], ",", 
         " ", "\"\<included\>\"", ",", " ", "\"\<neglected\>\""}], "]"}]}], ",",
       "\n", "\t\t", 
      RowBox[{"\"\<- \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"Length", "@", 
         RowBox[{"lgs", "[", "\"\<AtomicSystem\>\"", "]"}]}], "]"}], " ", "<>",
        " ", "\"\< total sublevels\>\""}], ",", "\n", 
      "\t\t", "\"\<#### Density matrix elements\>\"", ",", "\n", "\t\t", 
      RowBox[{"\"\<- All populations included\\n\>\"", " ", "<>", "\n", 
       "\t\t", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hasZeemanStructure", "@", 
          RowBox[{"lgs", "[", "\"\<AtomicSystem\>\"", "]"}]}], ",", 
         " ", "\"\<- All Zeeman coherences (between same level and same F) \
included\\n\>\"", ",", " ", "\"\<\>\""}], "]"}], " ", "<>", "\n", "\t\t", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hasHyperfineStructure", "@", 
          RowBox[{"lgs", "[", "\"\<AtomicSystem\>\"", "]"}]}], ",", 
         " ", "\"\<- All hyperfine coherences (between same level and \
different F) neglected\\n\>\"", ",", " ", "\"\<\>\""}], "]"}], " ", "<>", 
       "\n", "\t\t", "\"\<- Optical coherences (between different levels) \
included for pump transitions only\>\""}], ",", "\n", "\t\t", 
      RowBox[{"\"\<- \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "@", 
        RowBox[{"lgs", "[", "\"\<NVariables\>\"", "]"}]}], " ", "<>", 
       " ", "\"\< total density matrix elements\>\""}], ",", "\n", 
      "\t\t", "\"\<#### Input parameters\>\"", ",", "\n", "\t\t", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\"\<- \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "@", "#"}]}], " ", "&"}], "/@", " ", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"standardizeNotation", "[", 
            RowBox[{"lgs", ",", " ", 
             RowBox[{"lgs", "[", "\"\<InputParameters\>\"", "]"}]}], "]"}], ",",
            " ", "1"}], "]"}]}], ",", " ", "\"\<\\n\>\""}], "]"}]}], "\n", 
     "\t", "}"}], ",", "\n", "\t", "\"\<\\n\>\""}], "\n", "]"}]}]], "Code",
 CellLabel->
