Cell[BoxData[
 RowBox[{
  RowBox[{"generateExperimentalSystem", "[", 
   RowBox[{
   "pumpTransitions_", ",", " ", "pumpTransitionsNoHF_", ",", " ", 
    "atomicSystem_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"opticalParameters", ",", " ", "experimentalSystem"}], "}"}], ",",
     "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{"Define", " ", "experimental", " ", 
      RowBox[{"system", ".", " ", "The"}], " ", "two", " ", "regions", " ", 
      "represent", " ", "two", " ", "velocity", " ", 
      RowBox[{"groups", "."}]}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{"opticalParameters", " ", "=", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "\n", "        ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Subtract", " ", "@@", " ", 
              RowBox[{"Energy", " ", "/@", " ", "#1"}]}]}], " ", "+", " ", 
            RowBox[{"Detuning", "[", "#2", "]"}], " ", "-", " ", 
            RowBox[{"DopplerShift", "[", 
             RowBox[{"#1", ",", " ", "v"}], "]"}]}], ",", "\n", "        ", 
           RowBox[{
            RowBox[{"RabiFrequency", "[", "#2", "]"}], " ", "/", " ", 
            RowBox[{"ReducedME", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Sort", "[", "#1", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Dipole", ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{"Sort", "[", "#1", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"PolarizationAngle", "[", "#2", "]"}], ",", " ", 
             RowBox[{"Ellipticity", "[", "#2", "]"}]}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{"AllowedCouplings", " ", "->", " ", "#2"}], ",", "\n", 
           "        ", 
           RowBox[{"OpticalWidth", " ", "->", " ", 
            RowBox[{"LaserWidth", "[", "#2", "]"}]}]}], "\n", "    ", "}"}], 
         "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pumpTransitionsNoHF", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], ",",
           " ", "pumpTransitions"}], "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"experimentalSystem", " ", "=", " ", 
      RowBox[{
       RowBox[{"Table", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"ExperimentalRegion", "[", 
          RowBox[{"v", ",", " ", 
           RowBox[{"{", "\n", "            ", 
            RowBox[{
             RowBox[{
              RowBox[{"TransitRate", "[", "VoidRegion", "]"}], " ", "->", " ",
               "BeamTransitRate"}], ",", "\n", "            ", 
             RowBox[{
              RowBox[{"TransitRate", "[", 
               RowBox[{"otherVG", "[", "v", "]"}], "]"}], " ", "->", " ", 
              RowBox[{"VccRate", "[", 
               RowBox[{"v", ",", " ", 
                RowBox[{"otherVG", "[", "v", "]"}]}], "]"}]}], ",", "\n", 
             "            ", 
             RowBox[{"Density", " ", "->", " ", 
              RowBox[{"AtomicDensity", " ", 
               RowBox[{"VGDensity", "[", "v", "]"}]}]}], ",", "\n", 
             "            ", 
             RowBox[{
             "OpticalParameters", " ", "->", " ", "opticalParameters"}], ",", 
             "\n", "            ", 
             RowBox[{"MagneticField", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"BField", " ", 
                 RowBox[{"{", "\n", "                ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Cos", "[", "MagneticAzimuth", "]"}], " ", 
                    RowBox[{"Sin", "[", "MagneticZenith", "]"}]}], ",", "\n", 
                   "                ", 
                   RowBox[{
                    RowBox[{"Sin", "[", "MagneticAzimuth", "]"}], " ", 
                    RowBox[{"Sin", "[", "MagneticZenith", "]"}]}], ",", "\n", 
                   "                ", 
                   RowBox[{"Cos", "[", "MagneticZenith", "]"}]}], "\n", 
                  "            ", "}"}]}], ",", " ", 
                RowBox[{"AllowedCouplings", " ", "->", " ", 
                 RowBox[{"F", " ", "==", " ", 
                  RowBox[{"F", "'"}]}]}]}], "}"}]}], ",", "\n", 
             "            ", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"VelocityGroupRecoilMomentum", "[", 
                 RowBox[{"otherVG", "[", "v", "]"}], "]"}], " ", "->", " ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"v", " ", "==", " ", "1"}], ",", " ", 
                  RowBox[{"AtomicMass", " ", 
                   RowBox[{"VGWidth", "[", "1", "]"}]}], ",", " ", 
                  "Infinity"}], "]"}]}], ","}], "*)"}], "\n", "            ", 
             
             RowBox[{
              RowBox[{"VelocityGroupRecoilMomentum", "[", 
               RowBox[{"otherVG", "[", "v", "]"}], "]"}], " ", "->", " ", 
              RowBox[{"-", 
               RowBox[{"VGWidth", "[", 
                RowBox[{"otherVG", "[", "v", "]"}], "]"}]}]}], ",", "\n", 
             "            ", 
             RowBox[{
             "SDampingRate", " ", "->", " ", "SDampingCollisionRate"}]}], 
            "\n", "        ", "}"}]}], "]"}], ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "2"}], "}"}]}], "\n", "    ", "]"}], " ", "/.",
        " ", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Energy", "/@", 
          RowBox[{"StateLabel", "@", "atomicSystem"}]}], " ", "->", " ", 
         RowBox[{"Energy", "@", "atomicSystem"}]}], "]"}]}]}], ";", "\n", 
     "    ", 
     RowBox[{"{", 
      RowBox[{"opticalParameters", ",", " ", "experimentalSystem"}], 
      "}"}]}]}], "\n", "]"}]}]], "Code",
 CellLabel->"In[84]:=",ExpressionUUID->"090aba54-ae4e-4242-bd02-0ba45fda6064"],

