Cell[BoxData[
 RowBox[{
  RowBox[{"generateAtomicSystem", "[", 
   RowBox[{
   "states_", ",", " ", "pumpTransitions_", ",", " ", "stateLabelFunction_", ",",
     "quantumNumbers_", ",", "neglectedElements_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
