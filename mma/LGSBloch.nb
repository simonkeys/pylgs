        RowBox[{"{", "\n", "\t\t\t", 
         RowBox[{"\"\<A_ind\>\"", ",", " ", "\"\<A_dop\>\"", ",", 
          " ", "\"\<A_rec\>\"", ",", " ", "\"\<A_vcc\>\"", ",", 
          " ", "\"\<b\>\"", ",", " ", "\"\<Flux\>\""}], "\n", "\t\t", "}"}]}],
        ",", "\n", "\t\t", 
       RowBox[{"{", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
