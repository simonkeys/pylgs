Cell[BoxData[
 RowBox[{
  RowBox[{"levelDiagramNotToScale", "[", 
   RowBox[{"atomicSystem_", ",", "stateLabels_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "h0", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h0", " ", "=", " ", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Hamiltonian", "[", "atomicSystem", "]"}], "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Energy", "/@", "stateLabels"}], "->", 
            RowBox[{
             RowBox[{"Range", "@", 
              RowBox[{"Length", "@", "stateLabels"}]}], "-", "1"}]}], "]"}]}],
          "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"hb_HyperfineB", "->", ".02"}], ",", " ", 
           RowBox[{"ha_HyperfineA", "->", ".05"}]}], "}"}]}], ",", "Max"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LevelDiagram", "[", 
        RowBox[{
