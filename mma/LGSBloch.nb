         RowBox[{
          RowBox[{"StateLabel", "@", "#"}], ",", " ", "\"\<(\>\"", ",", " ", 
          RowBox[{"F", " ", "==", " ", 
           RowBox[{"F", "@", "#"}]}], ",", " ", "\"\<)\>\""}], "}"}], "]"}], 
       "&"}]}], ";", "\n", "    ", 
     RowBox[{"stretchedState", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AtomicSystemType", "@", "atomicSystem"}], " ", "==", 
