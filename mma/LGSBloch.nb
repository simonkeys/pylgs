         RowBox[{"StateLabelPosition", "->", "Automatic"}]}], 
        "\[IndentingNewLine]", "]"}], "/.", 
       RowBox[{"\"\<InlineMath\>\"", "->", "\"\<InlineFormula\>\""}]}], "/.", 
      
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"x_", ",", "opts___"}], "]"}], ":>", 
       RowBox[{"Style", "[", 
