Cell[BoxData[
 RowBox[{
  RowBox[{"levelDiagramToy", "[", 
   RowBox[{
   "toyAtomicSystem_", ",", "opticalParameters_", ",", " ", "dataSI_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "h0", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h0", "=", 
      RowBox[{
       RowBox[{"Hamiltonian", "[", 
        RowBox[{
         RowBox[{"DeleteParameter", "[", 
          RowBox[{"toyAtomicSystem", ",", "J"}], "]"}], ",", 
         RowBox[{"ExperimentalRegion", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"OpticalParameters", "->", "opticalParameters"}]}], 
          "]"}]}], "]"}], "/.", "dataSI"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"h0", "=", 
      RowBox[{"h0", "/", 
       RowBox[{"Max", "@", 
        RowBox[{"Diagonal", "[", "h0", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"LevelDiagram", "[", 
        RowBox[{"toyAtomicSystem", ",", " ", "h0", ",", "\[IndentingNewLine]", 
         RowBox[{"StateLabel", " ", "->", " ", "True"}], ",", "\n", 
         "            ", 
         RowBox[{"StateLabelPosition", " ", "->", " ", "Automatic"}], ",", 
         "\n", "            ", 
         RowBox[{"LevelSpacing", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{".01", ",", " ", ".007"}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"MinLabelSpacing", "->", ".05"}], ",", "\[IndentingNewLine]", 
         RowBox[{"LevelLength", "->", ".2"}], ",", "\[IndentingNewLine]", 
         RowBox[{"ParityOffset", "->", "True"}], ",", "\n", "            ", 
         RowBox[{"ImageSize", "->", "Small"}]}], "\[IndentingNewLine]", "]"}],
        "/.", 
       RowBox[{"\"\<InlineMath\>\"", "->", "\"\<InlineFormula\>\""}]}], "/.", 
      
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"x_", ",", "opts___"}], "]"}], ":>", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"x", "/.", 
