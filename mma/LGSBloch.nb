        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"fLabels", " ", "=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"hfStateLabel", ",", " ", "pumpSubsystems", ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"pumpTransitions", " ", "->", " ", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", " ", 
          RowBox[{"{", 
           RowBox[{"fLabels", ",", " ", "transitionFrequencies"}], "}"}], ",",
           " ", "2"}], "]"}]}], "]"}], " ", "/.", " ", 
      RowBox[{"_Energy", " ", "->", " ", "0"}]}]}]}], "\n", "]"}]}]], "Code",
