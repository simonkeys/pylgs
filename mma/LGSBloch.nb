Cell[BoxData[
 RowBox[{
  RowBox[{"resonanceDetunings", "[", 
   RowBox[{"atomicSystem_", ",", " ", "pumpTransitions_"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{
      "hfStateLabel", ",", " ", "stretchedState", ",", " ", 
       "stretchedAtomicSystem", ",", " ", "pumpSubsystems", ",", " ", 
       "detunings", ",", " ", "fLabels"}], "*)"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"hfStateLabel", " ", "=", " ", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"StateLabel", "@", "#"}], ",", " ", "\"\<(\>\"", ",", " ", 
          RowBox[{"F", " ", "==", " ", 
           RowBox[{"F", "@", "#"}]}], ",", " ", "\"\<)\>\""}], "}"}], "]"}], 
       "&"}]}], ";", "\n", "    ", 
     RowBox[{"stretchedState", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AtomicSystemType", "@", "atomicSystem"}], " ", "==", 
         " ", "\"\<Toy\>\""}], ",", " ", "True", ",", " ", 
        RowBox[{"M", " ", "==", " ", "F"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"stretchedAtomicSystem", " ", "=", " ", 
      RowBox[{"SelectStates", "[", 
       RowBox[{"atomicSystem", ",", " ", "stretchedState"}], "]"}]}], ";", 
     "\n", "    ", 
     RowBox[{"pumpSubsystems", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"SelectDirectedTransitions", "[", 
         RowBox[{"stretchedAtomicSystem", ",", " ", 
          RowBox[{"#", " ", "&&", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"F", " ", "-", " ", 
              RowBox[{"F", "'"}]}], "]"}], " ", "<=", " ", "1"}]}]}], "]"}], 
        "&"}], " ", "/@", " ", "pumpTransitions"}]}], ";", "\n", "    ", 
     RowBox[{"detunings", " ", "=", " ", 
      RowBox[{
       RowBox[{"Apply", "[", 
        RowBox[{"transitionFrequency", ",", " ", "pumpSubsystems", ",", " ", 
         RowBox[{"{", "2", "}"}]}], "]"}], " ", "/.", " ", 
       RowBox[{"_Energy", " ", "->", " ", "0"}]}]}], ";", "\n", "    ", 
     RowBox[{"fLabels", " ", "=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"hfStateLabel", ",", " ", "pumpSubsystems", ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"Thread", "[", 
      RowBox[{"pumpTransitions", " ", "->", " ", 
       RowBox[{"Thread", " ", "/@", " ", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", " ", 
          RowBox[{"{", 
           RowBox[{"fLabels", ",", " ", "detunings"}], "}"}]}], "]"}]}]}], 
      "]"}]}]}], "\n", "]"}]}]], "Code",
