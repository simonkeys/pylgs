Cell[BoxData[
 RowBox[{
  RowBox[{"generateExperimentalSystem", "[", 
   RowBox[{
   "pumpTransitions_", ",", " ", "pumpTransitionsNoHF_", ",", " ", 
    "atomicSystem_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"opticalParameters", ",", " ", "experimentalSystem"}], "}"}], ",",
     "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{"Define", " ", "experimental", " ", 
      RowBox[{"system", ".", " ", "The"}], " ", "two", " ", "regions", " ", 
      "represent", " ", "two", " ", "velocity", " ", 
      RowBox[{"groups", "."}]}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{"opticalParameters", " ", "=", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", "\n", "        ", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Subtract", " ", "@@", " ", 
              RowBox[{"Energy", " ", "/@", " ", "#1"}]}]}], " ", "+", " ", 
            RowBox[{"Detuning", "[", "#2", "]"}], " ", "-", " ", 
            RowBox[{"DopplerShift", "[", 
             RowBox[{"#1", ",", " ", "v"}], "]"}]}], ",", "\n", "        ", 
           RowBox[{
            RowBox[{"RabiFrequency", "[", "#2", "]"}], " ", "/", " ", 
            RowBox[{"ReducedME", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Sort", "[", "#1", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Dipole", ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{
               RowBox[{"Sort", "[", "#1", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", "\n", 
           "        ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"hasZeemanStructure", "@", "atomicSystem"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"PolarizationAngle", "[", "#2", "]"}], ",", " ", 
               RowBox[{"Ellipticity", "[", "#2", "]"}]}], "}"}], ",", " ", 
             RowBox[{"{", "}"}]}], "]"}], ",", "\n", "        ", 
           RowBox[{"AllowedCouplings", " ", "->", " ", "#2"}], ",", "\n", 
           "        ", 
           RowBox[{"OpticalWidth", " ", "->", " ", 
            RowBox[{"LaserWidth", "[", "#2", "]"}]}]}], "\n", "    ", "}"}], 
         "&"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pumpTransitionsNoHF", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], ",",
           " ", "pumpTransitions"}], "}"}]}], "]"}]}], ";", "\n", "    ", 
