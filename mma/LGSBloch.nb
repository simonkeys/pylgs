Cell[BoxData[
 RowBox[{
  RowBox[{"generateEquations", "[", 
   RowBox[{
   "atomicSystem_", ",", " ", "experimentalSystem_", ",", " ", "dataSI_", ",",
     " ", "states_", ",", " ", "stateLabels_", ",", " ", 
    "stateLabelFunction_", ",", " ", "pumpTransitionsNoHF_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "h", ",", " ", "hRWA", ",", " ", "repopulation", ",", " ", "relaxation", 
      ",", " ", "recoil", ",", " ", "recoilFactors", ",", " ", 
      "noVccCoherenceTransfer", ",", " ", "eqsN", ",", " ", "vars", ",", " ", 
      "substituteNumericalParameters", ",", " ", "fluorescence"}], "}"}], ",",
     "\n", "    ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Define", " ", "Hamiltonian"}], ",", " ", 
      RowBox[{"repopulation", " ", "and", " ", "relaxation", " ", 
       RowBox[{"matrices", "."}]}]}], " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{"h", " ", "=", " ", 
      RowBox[{"Hamiltonian", "[", 
       RowBox[{"atomicSystem", ",", " ", "experimentalSystem"}], "]"}]}], ";",
      "\n", "\t", 
     RowBox[{"hRWA", " ", "=", " ", 
      RowBox[{"RotatingWaveApproximation", "[", 
       RowBox[{
       "atomicSystem", ",", " ", "experimentalSystem", ",", " ", "h"}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{"repopulation", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Repopulation", "[", 
          RowBox[{"atomicSystem", ",", " ", "experimentalSystem"}], "]"}], 
         " ", "+", " ", 
         RowBox[{"OpticalBroadening", "[", 
          RowBox[{"atomicSystem", ",", " ", "experimentalSystem"}], "]"}]}], 
        " ", "/.", " ", 
        RowBox[{"_Wavenumber", " ", "->", " ", "0"}]}], " ", "//", " ", 
       "Expand"}]}], ";", "\n", "\t", 
     RowBox[{"relaxation", " ", "=", " ", 
      RowBox[{"Relaxation", "[", 
       RowBox[{"atomicSystem", ",", " ", "experimentalSystem"}], "]"}]}], ";",
      "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
      "Make", " ", "uniform", " ", "hard", " ", "collisions", " ", 
       "assumption", " ", "for", " ", "VCC"}], "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"repopulation", ",", " ", "relaxation"}], "}"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"repopulation", ",", " ", "relaxation"}], "}"}], " ", "/.", 
        " ", "hardCollisions"}], " ", "/.", " ", "uniformVCC"}]}], ";", "\n", 
     "\t", 
     RowBox[{"recoil", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"OpticalRepopulation", "[", 
         RowBox[{"atomicSystem", ",", " ", "experimentalSystem"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "/.", " ", "\n", "\t\t", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"BranchingRatio", "@@", "#"}], " ", "->", " ", 
            RowBox[{
             RowBox[{"RecoilVelocity", "[", "#", "]"}], " ", 
             RowBox[{"BranchingRatio", "@@", "#"}], " ", 
             RowBox[{"VGInverseWidth", "[", "1", "]"}]}]}], "&"}], " ", "/@", 
          " ", 
          RowBox[{"Reverse", " ", "/@", " ", 
           RowBox[{"pumpTransitionsNoHF", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", " ", "All", ",", " ", "2"}], "]"}], 
            "]"}]}]}], ",", " ", 
         RowBox[{"_BranchingRatio", " ", "->", " ", "0"}]}], "]"}]}]}], ";", 
     "\n", "\t", 
     RowBox[{"repopulation", " ", "=", " ", 
      RowBox[{"repopulation", " ", "+", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "recoil"}], ",", " ", "recoil"}], "}"}]}]}], ";", "\n", 
     "\t", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", " ", "VCC", " ", "relaxation"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"v", ".", "g", ".", " ", "#1"}], "  ", "relaxes", " ", "at", 
         " ", "a", " ", "rate", " ", "VccRate", " ", "*", " ", 
         RowBox[{"VGDensity", "[", "2", "]"}]}], " ", "=", " ", 
        RowBox[{"VccRate", " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"VGDensity", "[", "1", "]"}]}], ")"}]}]}]}], " ", "*)"}], 
     "\n", "\t", 
     RowBox[{"relaxation", " ", "=", " ", 
      RowBox[{"relaxation", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VccRate", " ", 
          RowBox[{"VGDensity", "[", "other_", "]"}]}], " ", ":>", " ", 
         RowBox[{"VccRate", 
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"VGDensity", "[", 
             RowBox[{"3", " ", "-", " ", "other"}], "]"}]}], ")"}]}]}], 
        "}"}]}]}], ";", "\n", "\t", 
     RowBox[{"recoilFactors", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"RecoilVelocity", "[", 
          RowBox[{
           RowBox[{"stateLabelFunction", "@", "#1"}], " ", "->", " ", 
           RowBox[{"stateLabelFunction", "@", "#2"}]}], "]"}], " ", "->", " ", 
         RowBox[{"RecoilParameter", " ", 
          RowBox[{"RecoilVelocity", "[", 
           RowBox[{"#2", ",", " ", "#1", ",", " ", "TemperatureK"}], 
           "]"}]}]}], "&"}], " ", "@@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"decays", "[", 
          RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}], " ", "/.",
          " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"stateLabels", " ", "->", " ", "states"}], "]"}]}], 
        ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"noVccCoherenceTransfer", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", " ", ":", " ", 
           RowBox[{
            RowBox[{"VGDensity", "[", "_", "]"}], " ", "VccRate", " ", 
            RowBox[{"DMElementPattern", "[", "]"}]}]}], " ", "/;", "  ", 
          RowBox[{
           RowBox[{"StateLabel1", " ", "==", " ", "StateLabel2"}], " ", "&&", 
           " ", 
           RowBox[{"F1", " ", "==", " ", "F2"}]}]}], " ", ":>", " ", "x"}], ",",
         " ", 
        RowBox[{
         RowBox[{
          RowBox[{"VGDensity", "[", "_", "]"}], " ", "VccRate", " ", 
          RowBox[{"DMElementPattern", "[", "]"}]}], " ", "->", " ", "0"}]}], 
       "}"}]}], ";", "\n", "    ", 
     RowBox[{"eqsN", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"LiouvilleEquation", "[", 
           RowBox[{
           "atomicSystem", ",", " ", "experimentalSystem", ",", " ", "hRWA", ",",
             " ", "relaxation", ",", " ", "repopulation"}], "]"}], " ", "/.", 
          " ", "noVccCoherenceTransfer"}], " ", "/.", " ", 
         RowBox[{"branchingRatios", "[", 
          RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}]}], " ", "/.",
         " ", "dataSI"}], " ", "/.", " ", "SIUnits"}]}], ";", "\n", "\t", 
     RowBox[{"vars", " ", "=", " ", 
      RowBox[{"DMVariables", "[", 
       RowBox[{"atomicSystem", ",", " ", "experimentalSystem"}], "]"}]}], ";",
      "\n", "\t", 
     RowBox[{"substituteNumericalParameters", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", "/.", " ", "dopplerShifts"}], " ", "/.", " ", 
               RowBox[{"dopplerWidths", "[", "pumpTransitionsNoHF", "]"}]}], 
              " ", "/.", " ", "\n", "\t\t", 
              RowBox[{"rabiToIntensity", "[", 
               RowBox[{"atomicSystem", ",", " ", "pumpTransitionsNoHF"}], 
               "]"}]}], " ", "/.", " ", "bohrMagneton"}], "  ", "/.", " ", 
            "dataSI"}], " ", "/.", " ", "experimentalParameters"}], " ", "/.",
           " ", "SIUnits"}], " ", "/.", " ", "recoilFactors"}], " ", "/.", 
        " ", 
        RowBox[{"branchingRatios", "[", 
         RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}]}], "&"}]}],
      ";", "\n", "\t", 
     RowBox[{"fluorescence", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"Fluorescence", "[", 
                RowBox[{
                "atomicSystem", ",", " ", "#", ",", " ", "0", ",", " ", "0", ",",
                  " ", 
                 RowBox[{"DMLabel", " ", "->", " ", "i"}]}], "]"}], ",", " ", 
               
               RowBox[{"{", 
                RowBox[{"i", ",", " ", "2"}], "}"}]}], "]"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"Subtract", " ", "@@", " ", 
               RowBox[{"Energy", " ", "/@", " ", "#"}]}], ")"}]}], "&"}], " ",
            "/@", " ", 
           RowBox[{"decays", "[", 
            RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}]}], " ", 
          "/.", " ", 
          RowBox[{"branchingRatios", "[", 
           RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}]}], " ", "/.",
          " ", "dataSI"}], " ", "/.", " ", "SIUnits"}], " ", "//", " ", 
       "Expand"}]}], ";", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{
      "eqsN", ",", " ", "vars", ",", " ", "substituteNumericalParameters", ",",
        " ", "fluorescence"}], "}"}]}]}], "\n", "]"}]}]], "Code",
