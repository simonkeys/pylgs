                RowBox[{"decays", "[", 
                 RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}]}], 
               "}"}], ",", "  ", "dmSource"}], "}"}]}], "]"}], ",", "\n", 
          "        ", "fluorescenceTensorMatrix", ",", " ", "\n", "        ", 
          
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"resonanceDetunings", "[", 
               RowBox[{"atomicSystem", ",", " ", "pumpTransitions"}], "]"}], 
              " ", "/.", " ", "dataSI"}], " ", "/.", " ", "SIUnits"}], ","}], 
           "*)"}], "\n", "        ", 
          RowBox[{"naturalWidths", "[", "pumpTransitionsNoHF", "]"}], ",", 
          " ", "\n", "        ", 
          RowBox[{"dopplerWidths", "[", "pumpTransitionsNoHF", "]"}], ",", 
          " ", "\n", "        ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"substituteNumericalParameters", "@", 
             RowBox[{"shiftedTransitionFrequencies", "[", 
              RowBox[{"atomicSystem", ",", " ", "pumpTransitionsNoHF"}], 
              "]"}]}], ","}], " ", "*)"}], "\n", "        ", "vars", ",", " ",
           "\n", "        ", "dataSI", ",", " ", "\n", "        ", 
          "pumpTransitions", ",", " ", "\n", "        ", "stateLabels", ",", 
          "\n", "        ", "atomicSystem", ",", "\n", "        ", 
          RowBox[{"levelDiagramToy", "[", 
           RowBox[{
           "toyAtomicSystem", ",", " ", "opticalParameters", ",", " ", 
            "dataSI"}], "]"}], ",", "\n", "        ", 
          RowBox[{"levelDiagramToScale", "[", 
           RowBox[{"atomicSystem", ",", " ", "dataSI"}], "]"}], ",", "\n", 
          "        ", 
          RowBox[{"levelDiagramNotToScale", "[", 
           RowBox[{"atomicSystem", ",", " ", "stateLabels"}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"levelPopulations", "[", "atomicSystem", "]"}], ",", "\n", 
          "        ", 
          RowBox[{"hfStatePopulations", "[", "atomicSystem", "]"}], ",", "\n",
           "        ", "inputParameters", ",", "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"totalPopulationOperator", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Population\>\"", ",", " ", 
                RowBox[{"{", "\"\<\>\"", "}"}]}], "}"}], ",", " ", 
              "dmSource"}], "}"}]}], "]"}], ",", "\n", "        ", 
          RowBox[{"Append", "[", 
