Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"LGSGenerateSystem", "[", 
      RowBox[{"states_", ",", " ", "pumpTransitions_", ",", " ", 
       RowBox[{"opts", " ", ":", " ", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\n", "\t\t", 
        RowBox[{
        "quantumNumbers", ",", " ", "stateLabelFunction", ",", " ", 
         "neglectedElements", ",", " ", "\n", "\t\t", "dataSI", ",", " ", 
         "stateLabels", ",", " ", "toyAtomicSystem", ",", " ", 
         "groundStateLabels", ",", " ", "excitedStateLabels", ",", " ", 
         "atomicSystem", ",", " ", "pumpTransitionsNoHF", ",", " ", "\n", 
         "\t\t", "opticalParameters", ",", " ", "experimentalSystem", ",", 
         "\n", "\t\t", "eqsN", ",", " ", "vars", ",", " ", 
         "substituteNumericalParameters", ",", " ", "fluorescence", ",", "\n",
