    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dataSI", " ", "=", " ", 
      RowBox[{
       RowBox[{"atomicData", "[", 
        RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}], " ", "/.", 
       " ", "SIUnits"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"stateLabels", " ", "=", " ", 
      RowBox[{"stateLabelFunction", " ", "/@", " ", "states"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"interactionStates", " ", "=", " ", 
      RowBox[{
       RowBox[{"Or", " ", "@@", " ", 
        RowBox[{"Union", "@", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"List", " ", "@@@", " ", "pumpTransitions"}], ",", " ", 
           "1"}], "]"}]}]}], " ", "/.", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"stateLabels", " ", "->", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{"StateLabel", " ", "==", " ", "stateLabels"}], "]"}]}], 
        "]"}]}]}], ";", 
     RowBox[{"systemParameters", " ", "=", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"{", 
        RowBox[{
        "quantumNumbers", ",", " ", "Parity", ",", " ", "Energy", ",", " ", 
         "NaturalWidth", ",", " ", "BranchingRatio"}], "}"}]}]}], ";", 
     RowBox[{"toyAtomicSystem", " ", "=", " ", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"AtomicSystem", "[", 
         RowBox[{"states", ",", " ", "systemParameters", ",", " ", 
          RowBox[{"StateLabels", " ", "->", " ", "stateLabelFunction"}], ",", 
          " ", 
          RowBox[{"DropInexactValues", " ", "->", " ", "True"}]}], "]"}], ",",
         " ", 
