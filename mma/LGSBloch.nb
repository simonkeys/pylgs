Cell[BoxData[
 RowBox[{
  RowBox[{"resonanceDetunings", "[", 
   RowBox[{"atomicSystem_", ",", " ", "pumpTransitions_"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hfStateLabel", ",", " ", "stretchedState", ",", " ", 
      "stretchedAtomicSystem", ",", " ", "pumpSubsystems", ",", " ", 
      "transitionFrequencies", ",", " ", "fLabels"}], "}"}], ",", "\n", "\t", 
    
    RowBox[{
     RowBox[{"hfStateLabel", " ", "=", " ", 
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"StateLabel", "@", "#"}], ",", " ", "\"\<(\>\"", ",", " ", 
          RowBox[{"F", " ", "==", " ", 
           RowBox[{"F", "@", "#"}]}], ",", " ", "\"\<)\>\""}], "}"}], "]"}], 
       "&"}]}], ";", "\n", "    ", 
     RowBox[{"stretchedState", " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AtomicSystemType", "@", "atomicSystem"}], " ", "==", 
         " ", "\"\<Toy\>\""}], ",", " ", "True", ",", " ", 
        RowBox[{"M", " ", "==", " ", "F"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"stretchedAtomicSystem", " ", "=", " ", 
      RowBox[{"SelectStates", "[", 
       RowBox[{"atomicSystem", ",", " ", "stretchedState"}], "]"}]}], ";", 
     "\n", "    ", 
     RowBox[{"pumpSubsystems", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"SelectDirectedTransitions", "[", 
         RowBox[{"stretchedAtomicSystem", ",", " ", 
          RowBox[{"#", " ", "&&", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"F", " ", "-", " ", 
              RowBox[{"F", "'"}]}], "]"}], " ", "<=", " ", "1"}]}]}], "]"}], 
        "&"}], " ", "/@", " ", "pumpTransitions"}]}], ";", "\n", "    ", 
     RowBox[{"transitionFrequencies", " ", "=", " ", 
      RowBox[{"Apply", "[", 
       RowBox[{"transitionFrequency", ",", " ", "pumpSubsystems", ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"fLabels", " ", "=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"hfStateLabel", ",", " ", "pumpSubsystems", ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"pumpTransitions", " ", "->", " ", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Rule", ",", " ", 
          RowBox[{"{", 
           RowBox[{"fLabels", ",", " ", "transitionFrequencies"}], "}"}], ",",
           " ", "2"}], "]"}]}], "]"}], " ", "/.", " ", 
      RowBox[{"_Energy", " ", "->", " ", "0"}]}]}]}], "\n", "]"}]}]], "Code",
 CellLabel->
  "In[222]:=",ExpressionUUID->"143d75db-ab52-46c2-a1fb-4032c77cdb90"],

