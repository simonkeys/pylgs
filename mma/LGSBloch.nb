         "\[IndentingNewLine]", 
         RowBox[{"ArrowStyle", "->", 
          RowBox[{"Arrowheads", "[", 
           RowBox[{"0", ",", "0"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
         
         RowBox[{"ParityOffset", "->", "True"}], ",", "\[IndentingNewLine]", 
         RowBox[{"ImageSize", "->", "Small"}], ",", "\[IndentingNewLine]", 
         RowBox[{"StateLabel", "->", "True"}], ",", "\[IndentingNewLine]", 
