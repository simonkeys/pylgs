         "A11NoVCC", ",", " ", "A12VCC", ",", " ", "A21Recoil", ",", " ", 
         "totalPopulationOperator", ",", " ", "levelPopulationOperator", ",", 
         " ", "groundLevelPopulationOperator", ",", " ", 
         "excitedLevelPopulationOperator", ",", " ", "inputParameters", ",", 
         " ", "\n", "\t    ", "A11NoVCCVGCenter", ",", " ", "A11NoVCCVGWidth",
          ",", " ", "A11NoVCCVGInd", ",", "\n", "\t    ", "dmSource", ",", 
         " ", "dmRange"}], "\n", "\t", "}"}], ",", "\n", "\t", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "dataSI", ",", " ", "stateLabels", ",", " ", "toyAtomicSystem", ",",
            " ", "groundStateLabels", ",", " ", "excitedStateLabels", ",", 
           " ", "atomicSystem", ",", " ", "pumpTransitionsNoHF"}], "}"}], " ",
          "=", " ", 
         RowBox[{"generateAtomicSystem", "[", 
          RowBox[{
          "states", ",", " ", "pumpTransitions", ",", " ", 
           "stateLabelFunction", ",", " ", "quantumNumbers", ",", " ", 
           "neglectedElements"}], "]"}]}], ";", "    ", "\n", "\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"opticalParameters", ",", " ", "experimentalSystem"}], 
          "}"}], " ", "=", " ", 
         RowBox[{"generateExperimentalSystem", "[", 
          RowBox[{
          "pumpTransitions", ",", " ", "pumpTransitionsNoHF", ",", " ", 
           "atomicSystem"}], "]"}]}], ";", "\n", "\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "eqsN", ",", " ", "vars", ",", " ", "substituteNumericalParameters",
            ",", " ", "fluorescence"}], "}"}], " ", "=", " ", 
         RowBox[{"generateEquations", "[", 
          RowBox[{
          "atomicSystem", ",", " ", "experimentalSystem", ",", " ", "dataSI", 
           ",", " ", "states", ",", " ", "stateLabels", ",", " ", 
           "stateLabelFunction", ",", " ", "pumpTransitionsNoHF"}], "]"}]}], ";",
         "\n", "\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "nVars", ",", " ", "vars", ",", " ", "B1", ",", " ", "Fl1", ",", 
           " ", "A11NoVCC", ",", " ", "A12VCC", ",", " ", "A21Recoil", ",", 
           " ", "totalPopulationOperator", ",", " ", 
           "levelPopulationOperator", ",", " ", 
           "groundLevelPopulationOperator", ",", " ", 
           "excitedLevelPopulationOperator", ",", " ", "inputParameters", ",",
            " ", "A11NoVCCVGCenter", ",", " ", "A11NoVCCVGWidth", ",", " ", 
           "A11NoVCCVGInd"}], "}"}], " ", "=", " ", "\n", "\t", 
         RowBox[{"generateMatrices", "[", 
          RowBox[{
          "atomicSystem", ",", " ", "experimentalSystem", ",", " ", 
           "stateLabels", ",", " ", "groundStateLabels", ",", " ", 
           "excitedStateLabels", ",", " ", "substituteNumericalParameters", ",",
            " ", "vars", ",", " ", "eqsN", ",", " ", "fluorescence"}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"dmSource", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Density matrix (source)\>\"", ",", " ", "vars"}], 
          "}"}]}], ";", "\n", "    ", 
        RowBox[{"dmRange", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Density matrix (range)\>\"", ",", " ", "vars"}], 
          "}"}]}], ";", "\n", "    ", 
        RowBox[{"LGSSystem", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"decays", "[", 
           RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}], ",", 
          " ", "\n", "        ", 
          RowBox[{"decayWavelengths", "[", 
           RowBox[{"states", ",", " ", "stateLabelFunction"}], "]"}], ",", 
          " ", "\n", "        ", "nVars", ",", "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"A11NoVCCVGInd", ",", " ", 
            RowBox[{"{", 
             RowBox[{"dmRange", ",", " ", "dmSource"}], "}"}]}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"A11NoVCCVGCenter", ",", " ", 
            RowBox[{"{", 
             RowBox[{"dmRange", ",", " ", "dmSource"}], "}"}]}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"A11NoVCCVGWidth", ",", " ", 
            RowBox[{"{", 
             RowBox[{"dmRange", ",", " ", "dmSource"}], "}"}]}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"A12VCC", ",", " ", 
            RowBox[{"{", 
             RowBox[{"dmRange", ",", " ", "dmSource"}], "}"}]}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"A21Recoil", ",", " ", 
            RowBox[{"{", 
             RowBox[{"dmRange", ",", " ", "dmSource"}], "}"}]}], "]"}], ",", 
          "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"B1", ",", " ", 
            RowBox[{"{", 
             RowBox[{"dmRange", ",", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<none\>\"", ",", " ", 
                RowBox[{"{", "\"\<none\>\"", "}"}]}], "}"}]}], "}"}]}], "]"}],
           ",", " ", "\n", "        ", 
          RowBox[{"Append", "[", 
           RowBox[{"Fl1", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
